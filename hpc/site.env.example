# hpc/site.env  -- created by the agent during first-run onboarding; NEVER commit this file.
# ---- execution mode: local | slurm
EXEC_MODE=local

# ---- local mode
LOCAL_DEVICE=auto            # auto | cuda | cpu   (Apple MPS is not supported by TORCWA)
LOCAL_MPI_NP=4               # MPI ranks for local Meep runs

# ---- slurm mode (fill only if EXEC_MODE=slurm)
SSH_TARGET=                  # user@login.cluster.example
SSH_LOGIN_CMD=               # optional command that refreshes credentials (e.g. a 2FA/SSH-certificate helper)
REMOTE_DIR=metasurface-agent-pipeline   # path relative to the remote $HOME (or work area)
SLURM_ACCOUNT=               # budget/project account, if the site requires one
GPU_SBATCH="--partition=<gpu-partition> --gres=gpu:1 --cpus-per-task=8 --mem=64G --time=04:00:00"
GPU_SHORT_SBATCH="--time=00:30:00"         # e.g. add a debug QOS here
CPU_SBATCH="--partition=<cpu-partition> --ntasks=48 --mem=200G --time=04:00:00"
MAX_PARALLEL_GPU=1           # concurrent array tasks allowed by the site QOS
ENV_MODULES=                 # modules to load before creating the venv, e.g. "python/3.11"

# ---- torch wheels (match the GPU driver: CUDA 12.x drivers -> cu126; CUDA 11.x -> cu118 + torch==2.7.1)
TORCH_INDEX=
TORCH_SPEC=torch
